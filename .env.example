# ─── Razorpay (REQUIRED) ─────────────────────────────────────────────────────
# Server boots and exits immediately if this does not start with "rzp_test_"
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# Razorpay webhook secret — set this in the Razorpay dashboard and copy here
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ─── LLM provider (REQUIRED for live agent runs) ──────────────────────────────
# Groq is what this build actually runs against; qwen/qwen3.8-27b is the model
# every recorded LLM_CALL was made with. Set GROQ_API_KEY and leave
# LLM_PROVIDER blank to infer it.
GROQ_API_KEY=gsk_REPLACE_ME
# Optional. Comma-separated extra Groq keys, tried in order when the primary is
# rate limited or rejected. Each key has its own tokens-per-minute quota, so
# these are additional capacity rather than a retry against an exhausted one.
# Every failover is recorded to the ledger as LLM_KEY_FAILOVER.
GROQ_API_KEYS_FALLBACK=
# Alternative provider, supported but not what the recorded runs used.
# XAI_API_KEY=xai-REPLACE_ME
# Force a provider instead of inferring from whichever key is set: groq | xai
LLM_PROVIDER=groq

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, zero config):
DATABASE_URL=sqlite:///./tollgate.db
# Postgres (one-line switch, requires docker-compose or external PG):
# DATABASE_URL=postgresql+psycopg2://tollgate:tollgate@localhost:5432/tollgate

# ─── Agent keypairs (auto-generated at boot if files absent) ─────────────────
BUYER_AGENT_PRIVATE_KEY_PATH=./keys/buyer_es256.pem
BUYER_AGENT_PUBLIC_KEY_PATH=./keys/buyer_es256_pub.pem
MERCHANT_AGENT_PRIVATE_KEY_PATH=./keys/merchant_es256.pem
MERCHANT_AGENT_PUBLIC_KEY_PATH=./keys/merchant_es256_pub.pem

# ─── Feature flags ────────────────────────────────────────────────────────────
# Set true to enable POST /ledger/tamper (demo only, never in prod)
ALLOW_TAMPER=false

# Set true to replace LLM calls with recorded fixtures (CI / eval harness)
STUB_MODE=false

# How an approved escalation settles: synthetic | replay | live
#   synthetic  identifiers generated locally, no network at all (default)
#   replay     the recorded capture in evals/fixtures/razorpay_capture.json
#   live       a real test-mode order + payment link, polled until paid
# Defaults to synthetic on purpose: a stage demo must not depend on Razorpay
# being reachable.
PAYMENTS_MODE=synthetic
PAYMENT_CAPTURE_TIMEOUT_SECONDS=300
PAYMENT_POLL_INTERVAL_SECONDS=2
# Used only to derive an expected settlement date for a deferred refund.
SETTLEMENT_CYCLE_DAYS=2
REFUND_RETRY_INTERVAL_SECONDS=3600

# ─── Policy limits ────────────────────────────────────────────────────────────
# Hard daily spend ceiling per buyer (paise)
DAILY_SPEND_CAP_PAISE=5000000

# Velocity: ESCALATE if more than N transactions in window_seconds
VELOCITY_MAX_TXN=5
VELOCITY_WINDOW_SECONDS=3600

# ─── Reconciler ───────────────────────────────────────────────────────────────
# How often the orphan-payment sweeper runs (seconds)
RECONCILER_INTERVAL_SECONDS=30

# How old a PAYMENT_CAPTURED entry must be before the reconciler re-drives (seconds)
ORPHANED_PAYMENT_TIMEOUT_SECONDS=60
